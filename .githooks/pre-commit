#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
	printf '%s\n' 'Install Gitleaks v8.30.1 before committing to this repository.' >&2
	exit 1
fi

exec gitleaks git --pre-commit --staged --config .gitleaks.toml \
	--ignore-gitleaks-allow --gitleaks-ignore-path /dev/null --redact --no-banner .
